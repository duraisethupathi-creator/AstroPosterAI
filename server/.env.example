# No external AI credentials. Use true only for explicit mock testing.
AI_MOCK_MODE=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3.5:2b-q4_K_M
# One total inference deadline, including at most one repair.
LOCAL_AI_TIMEOUT_MS=60000
LOCAL_AI_CONTEXT=4096
LOCAL_AI_MAX_TOKENS=768
LOCAL_AI_THINK=false
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Browser origins only; native Android does not send an Origin header.
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
# Live production requires an authenticated reverse proxy (not a mobile secret).
TRUSTED_AUTH_PROXY=false
