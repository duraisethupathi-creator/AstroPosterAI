{
  "expo": {
    "name": "AstroPoster AI",
    "slug": "astroposter-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.astroposterai.app"
    },
    "ios": {
      "bundleIdentifier": "com.astroposterai.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"cameraPermission": false, "microphonePermission": false}]
    ],
    "scheme": "astroposterai"
  }
}
